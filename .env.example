# Copy to a local, ignored .env file or inject through the deployment Secret Manager.
# Never paste a real secret into this file.
APP_ENV=development
STORAGE_BACKEND=memory
KEY_PROVIDER=test-only
TEST_ENCRYPTION_KEY_HEX=
DATABASE_URL=postgresql://app:CHANGE_ME@localhost:5432/samsara
REDIS_URL=redis://localhost:6379/0
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=strict
# Optional local-only bootstrap; never enable in production.
DEV_INVITATION_TOKEN=

LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
LLM_DAILY_TOKEN_BUDGET=0
LLM_OUTBOUND_HOST_ALLOWLIST=api.deepseek.com

FIELD_ENCRYPTION_KEY_ID=
RULESET_BAZI_ENABLED=false
RULESET_ZIWEI_ENABLED=false
RULESET_YIJING_ENABLED=false
FEATURE_HIGH_PRACTICE_EXPERIMENT=false
FEATURE_WEALTH_DIMENSION_DEFAULT=false
