# Reference only. Run `python scripts/init_env.py` to create ignored `.env`
# with local secrets. This file intentionally contains no usable secret.
APP_ENV=development
SANJI_VERSION=v1-candidate
PUBLIC_ORIGIN=http://127.0.0.1:3000
SESSION_COOKIE_SECURE=false

POSTGRES_DB=sanjiguan
POSTGRES_MIGRATION_PASSWORD=<GENERATE_LOCALLY>
POSTGRES_APP_PASSWORD=<GENERATE_LOCALLY>
KEY_PROVIDER=env-aesgcm
FIELD_ENCRYPTION_KEY_ID=<NON_SECRET_KEY_VERSION>
FIELD_ENCRYPTION_KEY_HEX=<64_HEX_FROM_SECRET_STORE>
OWNER_BOOTSTRAP_TOKEN=<GENERATE_LOCALLY_MINIMUM_32_CHARACTERS>

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_MAX_TOKENS=900
LLM_MAX_REQUESTS=6
LLM_DAILY_TOKEN_BUDGET=0
LLM_OUTBOUND_HOST_ALLOWLIST=api.deepseek.com
DB_POOL_MAX=8
DOMAIN=<YOUR_DOMAIN>

RULESET_BAZI_ENABLED=false
RULESET_ZIWEI_ENABLED=false
RULESET_YIJING_ENABLED=false
FEATURE_HIGH_PRACTICE_EXPERIMENT=false
FEATURE_WEALTH_DIMENSION_DEFAULT=false
