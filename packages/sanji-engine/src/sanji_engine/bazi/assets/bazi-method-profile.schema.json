{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sanjiguan.local/sanji-engine/bazi-method-profile/1.0.0",
  "title": "BaZi Method Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "profile_id", "profile_version", "profile_class",
    "status", "production_activatable", "calendar_basis",
    "legal_time_policy", "solar_time_mode", "year_boundary_policy",
    "month_boundary_policy", "day_rollover_policy",
    "hour_boundary_policy", "boundary_inclusion_policy",
    "historical_calendar_policy", "unknown_time_policy",
    "location_precision_policy", "source_claim_ids", "review_status",
    "reviewer_requirements", "known_disputes", "selection_authority",
    "content_hash"
  ],
  "properties": {
    "schema_version": {"const": "bazi-method-profile/1.0.0"},
    "profile_id": {"type": "string", "pattern": "^BAZI\\.PROFILE\\.[A-Z0-9_.-]+$"},
    "profile_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "profile_class": {"const": "profile_discriminating_candidate"},
    "status": {"enum": ["draft", "review_candidate"]},
    "production_activatable": {"const": false},
    "calendar_basis": {"$ref": "#/$defs/policy"},
    "legal_time_policy": {"$ref": "#/$defs/policy"},
    "solar_time_mode": {"$ref": "#/$defs/policy"},
    "year_boundary_policy": {"$ref": "#/$defs/policy"},
    "month_boundary_policy": {"$ref": "#/$defs/policy"},
    "day_rollover_policy": {"$ref": "#/$defs/policy"},
    "hour_boundary_policy": {"$ref": "#/$defs/policy"},
    "boundary_inclusion_policy": {"$ref": "#/$defs/policy"},
    "historical_calendar_policy": {"$ref": "#/$defs/policy"},
    "unknown_time_policy": {"$ref": "#/$defs/policy"},
    "location_precision_policy": {"$ref": "#/$defs/policy"},
    "source_claim_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string"}
    },
    "review_status": {"enum": ["UNCONFIRMED", "PENDING_QUALIFIED_REVIEW"]},
    "reviewer_requirements": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string"}
    },
    "known_disputes": {
      "type": "array", "minItems": 1, "items": {"type": "string"}
    },
    "selection_authority": {"const": "CANDIDATE_ONLY_NOT_OWNER_DECISION"},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id", "decision_status", "selected_option", "options",
        "decision_refs"
      ],
      "properties": {
        "policy_id": {"type": "string"},
        "decision_status": {"enum": ["FROZEN", "CANDIDATE", "UNCONFIRMED"]},
        "selected_option": {"type": ["string", "null"]},
        "options": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string"}
        },
        "decision_refs": {
          "type": "array", "uniqueItems": true, "items": {"type": "string"}
        },
        "notes": {"type": "string"}
      }
    }
  }
}
