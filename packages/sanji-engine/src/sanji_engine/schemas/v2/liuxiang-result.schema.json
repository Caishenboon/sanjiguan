{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sanjiguan.invalid/schemas/liuxiang-result/1.0.0",
  "title": "Deterministic Liuxiang Research Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "tradition_scope", "activation", "review_status",
    "production_activatable", "engine_version", "ruleset_version",
    "dimension_contract_hash", "mapping_asset_hash", "signals",
    "effective_signals", "deduplication", "shared_source_discounts",
    "candidates", "status", "leading_candidate_id", "strength_bp",
    "confidence_bp", "trace_ref", "result_hash"
  ],
  "properties": {
    "schema_version": {"const": "liuxiang-result/1.0.0"},
    "tradition_scope": {"const": "sanji_original"},
    "activation": {"const": "research_active"},
    "review_status": {"const": "UNCONFIRMED"},
    "production_activatable": {"const": false},
    "engine_version": {"type": "string"},
    "ruleset_version": {"const": "liuxiang-inference/1.0.0"},
    "dimension_contract_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "mapping_asset_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "signals": {"type": "array", "items": {"$ref": "https://sanjiguan.invalid/schemas/signal-v2/1.0.0"}},
    "effective_signals": {"type": "array", "items": {"$ref": "https://sanjiguan.invalid/schemas/signal-v2/1.0.0"}},
    "deduplication": {"type": "array", "items": {"type": "object"}},
    "shared_source_discounts": {"type": "array", "items": {"type": "object"}},
    "candidates": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "candidate_id", "dimension_id", "supporting_signal_ids",
          "counterevidence_signal_ids", "hard_conflicts", "soft_conflicts",
          "missing_facts", "source_coverage", "independent_evidence_count",
          "shared_source_groups", "raw_strength", "calibrated_strength_bp",
          "confidence_bp", "status", "rank", "stable_tie_break_key",
          "ruleset_version", "trace_ref", "result_hash"
        ]
      }
    },
    "status": {"enum": ["decisive", "provisional", "contested", "insufficient"]},
    "leading_candidate_id": {"type": "string"},
    "strength_bp": {"type": "integer", "minimum": 0, "maximum": 10000},
    "confidence_bp": {"type": "integer", "minimum": 0, "maximum": 10000},
    "trace_ref": {"type": "string"},
    "result_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
