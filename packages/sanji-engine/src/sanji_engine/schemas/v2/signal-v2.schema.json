{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sanjiguan.invalid/schemas/signal-v2/1.0.0",
  "title": "Sanji Engine Signal v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "signal_id", "subject_id", "dimension_id", "direction",
    "magnitude_bp", "source_system", "source_record_id", "source_fact_path",
    "source_claim_ids", "source_dataset_id", "source_dataset_revision",
    "mapping_rule_id", "mapping_ruleset_version", "profile_id",
    "source_reliability_bp", "mapping_reliability_bp", "independence_group",
    "shared_source_group", "temporal_scope", "supports", "counterevidence",
    "missingness", "disputes", "boundary_sensitivity", "trace_ref",
    "content_hash", "engine_version"
  ],
  "properties": {
    "schema_version": {"const": "signal-v2/1.0.0"},
    "signal_id": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "dimension_id": {"enum": ["lx_ming", "lx_ye", "lx_yuan", "lx_meng", "lx_yuan_relation", "lx_shi"]},
    "direction": {"enum": ["positive", "negative", "neutral"]},
    "magnitude_bp": {"type": "integer", "minimum": 0, "maximum": 10000},
    "source_system": {"enum": ["synthetic_conformance", "yijing", "bazi", "ziwei", "user_evidence", "external_research"]},
    "source_record_id": {"type": "string", "minLength": 1},
    "source_fact_path": {"type": "string", "minLength": 1},
    "source_claim_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "source_dataset_id": {"type": ["string", "null"]},
    "source_dataset_revision": {"type": ["string", "null"]},
    "mapping_rule_id": {"type": "string", "minLength": 1},
    "mapping_ruleset_version": {"type": "string", "minLength": 1},
    "profile_id": {"type": ["string", "null"]},
    "source_reliability_bp": {"type": "integer", "minimum": 0, "maximum": 10000},
    "mapping_reliability_bp": {"type": "integer", "minimum": 0, "maximum": 10000},
    "independence_group": {"type": "string", "minLength": 1},
    "shared_source_group": {"type": "string", "minLength": 1},
    "temporal_scope": {"type": "object"},
    "supports": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "counterevidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "missingness": {"type": "object"},
    "disputes": {"type": "object"},
    "boundary_sensitivity": {"type": "object"},
    "trace_ref": {"type": "string", "minLength": 1},
    "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "engine_version": {"type": "string", "minLength": 1}
  }
}
