{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samsara.local/schemas/birth-record.schema.json",
  "title": "Original birth record",
  "type": "object",
  "additionalProperties": false,
  "required": ["calendar_type", "local_date", "local_time", "timezone_id", "timezone_database", "timezone_database_version", "time_precision", "place", "user_confirmed", "captured_at"],
  "properties": {
    "calendar_type": {"enum": ["gregorian", "lunar"]},
    "local_date": {"type": "string", "format": "date"},
    "local_time": {"type": ["string", "null"], "format": "time"},
    "timezone_id": {"type": "string", "minLength": 1},
    "timezone_database": {"const": "IANA"},
    "timezone_database_version": {"type": "string", "minLength": 1},
    "time_precision": {"enum": ["minute", "double_hour", "half_day", "unknown"]},
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latitude", "longitude", "coordinate_source"],
      "properties": {
        "label": {"type": ["string", "null"]},
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180},
        "coordinate_source": {"type": "string", "minLength": 1}
      }
    },
    "user_confirmed": {"type": "boolean"},
    "captured_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"time_precision": {"const": "unknown"}}},
      "then": {"properties": {"local_time": {"type": "null"}}},
      "else": {"properties": {"local_time": {"type": "string", "format": "time"}}}
    }
  ]
}
