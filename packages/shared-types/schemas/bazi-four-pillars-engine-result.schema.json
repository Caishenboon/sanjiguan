{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sanjiguan.local/schemas/bazi-four-pillars-engine-result/1.0.0",
  "title": "BaZi Four Pillars Mechanical Research Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "module", "method_id", "method_version", "method_class",
    "research_status", "review_status", "production_activatable",
    "profile", "input_provenance", "calendar_version",
    "solar_term_data_version", "day_epoch", "boundary_case_asset_version",
    "boundary_case_asset_hash",
    "candidate_count", "raw_candidate_count", "candidate_limit", "candidates", "four_pillars",
    "profile_difference", "missing_data", "data_completeness",
    "candidate_truncated", "truncation_reason", "deduplication", "selection", "interpretation",
    "auspiciousness", "manifestation_period"
  ],
  "properties": {
    "module": {"const": "bazi"},
    "method_id": {"const": "BAZI.FOUR_PILLARS.MECHANICAL.RESEARCH.V1"},
    "method_version": {"const": "1.0.0"},
    "method_class": {"const": "traditional_mechanical_research_candidate"},
    "research_status": {"const": "research_active"},
    "review_status": {"const": "UNCONFIRMED"},
    "production_activatable": {"const": false},
    "profile": {"type": "object"},
    "input_provenance": {"type": "object"},
    "calendar_version": {"type": "string"},
    "solar_term_data_version": {"type": "string"},
    "day_epoch": {"type": "object"},
    "boundary_case_asset_version": {"const": "bazi-boundary-cases/1.0.0"},
    "boundary_case_asset_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "candidate_count": {"type": "integer", "minimum": 1, "maximum": 26},
    "raw_candidate_count": {"type": "integer", "minimum": 1, "maximum": 26},
    "candidate_limit": {"const": 26},
    "candidates": {"type": "array", "minItems": 1, "maxItems": 26},
    "four_pillars": {"type": ["object", "null"]},
    "profile_difference": {"type": "boolean"},
    "missing_data": {"type": "array", "items": {"type": "string"}},
    "data_completeness": {"enum": ["complete_input", "partial_unknown_time"]},
    "candidate_truncated": {"const": false},
    "truncation_reason": {"type": "null"},
    "deduplication": {"type": "object"},
    "selection": {"const": "explicit_profile_no_primary_chart"},
    "interpretation": {"type": "null"},
    "auspiciousness": {"type": "null"},
    "manifestation_period": {"type": "null"}
  }
}
