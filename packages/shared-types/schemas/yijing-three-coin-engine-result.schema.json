{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://sanjiguan.local/schemas/yijing-three-coin-engine-result.schema.json",
  "title":"Physical Three-Coin Mechanical Engine Result",
  "type":"object","additionalProperties":false,
  "required":["module","method_id","method_version","method_class","ruleset_id",
    "ruleset_status","production_activatable","input_order","tosses","lines",
    "moving_lines","lower_trigram","upper_trigram","base_hexagram",
    "transformed_lower_trigram","transformed_upper_trigram","transformed_hexagram",
    "has_transformed_hexagram","mapping_asset","interpretation","auspiciousness",
    "manifestation_period"],
  "properties":{
    "module":{"const":"yijing"},
    "method_id":{"const":"YIJING.THREE_COIN.PHYSICAL.MECHANICAL.V1"},
    "method_version":{"const":"1.0.0"},
    "method_class":{"const":"traditional_mechanical"},
    "ruleset_id":{"type":"string"},
    "ruleset_status":{"enum":["research_active","revoked_for_future_runs"]},
    "production_activatable":{"const":false},
    "input_order":{"const":"bottom_to_top"},
    "tosses":{"type":"array","minItems":6,"maxItems":6,"items":{"$ref":"#/$defs/toss"}},
    "lines":{"type":"array","minItems":6,"maxItems":6,"items":{"$ref":"#/$defs/line"}},
    "moving_lines":{"type":"array","uniqueItems":true,"items":{"type":"integer","minimum":1,"maximum":6}},
    "lower_trigram":{"$ref":"#/$defs/trigram"},
    "upper_trigram":{"$ref":"#/$defs/trigram"},
    "base_hexagram":{"$ref":"#/$defs/hexagram"},
    "transformed_lower_trigram":{"$ref":"#/$defs/trigram"},
    "transformed_upper_trigram":{"$ref":"#/$defs/trigram"},
    "transformed_hexagram":{"$ref":"#/$defs/hexagram"},
    "has_transformed_hexagram":{"type":"boolean"},
    "mapping_asset":{"type":"object"},
    "interpretation":{"type":"null"},
    "auspiciousness":{"type":"null"},
    "manifestation_period":{"type":"null"}
  },
  "$defs":{
    "toss":{"type":"object","additionalProperties":false,
      "required":["line_position","coin_values"],
      "properties":{"line_position":{"type":"integer","minimum":1,"maximum":6},
        "coin_values":{"type":"array","minItems":3,"maxItems":3,"items":{"enum":[2,3]}}}},
    "line":{"type":"object","additionalProperties":false,
      "required":["line_position","coin_values","sum","line_state","base_polarity",
        "moving","transformed_polarity","trigram_contribution"],
      "properties":{"line_position":{"type":"integer","minimum":1,"maximum":6},
        "coin_values":{"type":"array","minItems":3,"maxItems":3,"items":{"enum":[2,3]}},
        "sum":{"enum":[6,7,8,9]},
        "line_state":{"enum":["old_yin","young_yang","young_yin","old_yang"]},
        "base_polarity":{"enum":[0,1]},"moving":{"type":"boolean"},
        "transformed_polarity":{"enum":[0,1]},
        "trigram_contribution":{"enum":["lower","upper"]}}},
    "trigram":{"type":"object","additionalProperties":false,"required":["name","key"],
      "properties":{"name":{"type":"string"},"key":{"type":"string","pattern":"^[01]{3}$"}}},
    "hexagram":{"type":"object","additionalProperties":false,"required":["key","sequence","name"],
      "properties":{"key":{"type":"string","pattern":"^[01]{6}$"},
        "sequence":{"type":"integer","minimum":1,"maximum":64},"name":{"type":"string"}}}
  }
}
