{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sanjiguan.local/schemas/evidence-item.schema.json",
  "title": "六象证契",
  "type": "object",
  "additionalProperties": false,
  "required": ["id","profile_id","domain","type","title","raw_narrative","structured_payload",
    "observed_from","observed_to","first_observed_age","frequency","intensity","vividness",
    "duration_years","source_type","source_reliability","user_confidence",
    "independent_corroboration","possible_ordinary_explanations","counterevidence",
    "status","event_occurred_at","recorded_at"],
  "properties": {
    "id":{"type":"string","format":"uuid"},"profile_id":{"type":"string","format":"uuid"},
    "domain":{"enum":["ming","gua","karma","vow","dream","sensation","relation","life_event"]},
    "type":{"type":"string","minLength":1,"maxLength":100},
    "title":{"type":"string","minLength":1,"maxLength":200},
    "raw_narrative":{"type":"string","maxLength":10000},
    "structured_payload":{"type":"object"},
    "observed_from":{"type":["string","null"],"format":"date"},
    "observed_to":{"type":["string","null"],"format":"date"},
    "first_observed_age":{"type":["number","null"],"minimum":0,"maximum":150},
    "frequency":{"type":"integer","minimum":0,"maximum":10},
    "intensity":{"type":"integer","minimum":0,"maximum":10},
    "vividness":{"type":"integer","minimum":0,"maximum":10},
    "duration_years":{"type":"number","minimum":0},
    "source_type":{"enum":["document","self_memory","family_memory","repeated_observation","single_event"]},
    "source_reliability":{"type":"number","minimum":0,"maximum":1},
    "user_confidence":{"type":"number","minimum":0,"maximum":1},
    "independent_corroboration":{"type":"boolean"},
    "possible_ordinary_explanations":{"type":"array","items":{"type":"string","maxLength":500}},
    "counterevidence":{"type":"array","items":{"type":"string","maxLength":1000}},
    "status":{"enum":["draft","confirmed","disputed","withdrawn"]},
    "event_occurred_at":{"type":["string","null"],"format":"date-time"},
    "recorded_at":{"type":"string","format":"date-time"}
  }
}
