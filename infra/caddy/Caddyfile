{
  email off
  servers {
    timeouts {
      read_body 30s
      read_header 10s
      write 60s
      idle 2m
    }
  }
}

{$DOMAIN} {
  encode zstd gzip
  request_body {
    max_size 10MB
  }
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Frame-Options "DENY"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    -Server
  }
  reverse_proxy web:3000 {
    health_uri /
    health_interval 30s
  }
  log {
    output stdout
    format json
  }
}
