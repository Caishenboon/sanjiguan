        "required": [
          "original",
          "historical_utc_offset_minutes",
          "dst_offset_minutes",
          "longitude_correction_minutes",
          "equation_of_time_minutes",
          "total_apparent_correction_minutes",
          "candidates",
          "boundary_difference",
          "correction_chain",
          "warnings",
          "prohibited_conclusions"
