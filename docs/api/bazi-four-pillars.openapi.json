{
  "openapi": "3.1.0",
  "info": {
    "title": "Sanji Owner BaZi Mechanical Research API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/admin/research/bazi-four-pillars/structure": {
      "post": {
        "summary": "Execute Bazi Structure",
        "operationId": "execute_bazi_structure_api_v1_admin_research_bazi_four_pillars_structure_post",
        "parameters": [
          {
            "name": "__Host-session",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "  Host-Session"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BaziStructurePayload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/research/bazi-four-pillars/execute": {
      "post": {
        "summary": "Execute Bazi Research",
        "operationId": "execute_bazi_research_api_v1_admin_research_bazi_four_pillars_execute_post",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Idempotency-Key"
            }
          },
          {
            "name": "__Host-session",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "  Host-Session"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BaziExecutePayload"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/research/bazi-four-pillars/compare": {
      "post": {
        "summary": "Compare Bazi Profiles",
        "operationId": "compare_bazi_profiles_api_v1_admin_research_bazi_four_pillars_compare_post",
        "parameters": [
          {
            "name": "__Host-session",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "  Host-Session"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BaziComparePayload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BaziComparePayload": {
        "properties": {
          "profiles": {
            "items": {
              "$ref": "#/components/schemas/ProfileRef"
            },
            "type": "array",
            "maxItems": 3,
            "minItems": 1,
            "title": "Profiles"
          },
          "birth_record": {
            "$ref": "#/components/schemas/BirthRecord"
          },
          "input_provenance": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Input Provenance"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "profiles",
          "birth_record"
        ],
        "title": "BaziComparePayload"
      },
      "BaziExecutePayload": {
        "properties": {
          "profile_id": {
            "type": "string",
            "title": "Profile Id"
          },
          "profile_version": {
            "type": "string",
            "title": "Profile Version"
          },
          "profile_record_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Profile Record Id"
          },
          "birth_record": {
            "$ref": "#/components/schemas/BirthRecord"
          },
          "input_provenance": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Input Provenance"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "profile_id",
          "profile_version",
          "birth_record"
        ],
        "title": "BaziExecutePayload"
      },
      "BaziStructurePayload": {
        "properties": {
          "source_four_pillars": {
            "additionalProperties": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/StructurePillar"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object",
            "title": "Source Four Pillars"
          },
          "source_candidate_id": {
            "type": "string",
            "title": "Source Candidate Id"
          },
          "source_ruleset_id": {
            "type": "string",
            "title": "Source Ruleset Id",
            "default": "bazi-four-pillars-research-1.0.0"
          },
          "source_method_id": {
            "type": "string",
            "title": "Source Method Id",
            "default": "BAZI.FOUR_PILLARS.MECHANICAL.RESEARCH.V1"
          },
          "source_method_version": {
            "type": "string",
            "title": "Source Method Version",
            "default": "1.0.0"
          },
          "profile_id": {
            "type": "string",
            "title": "Profile Id",
            "default": "bazi-traditional-structure-research-v1"
          },
          "profile_version": {
            "type": "string",
            "title": "Profile Version",
            "default": "1.0.0"
          },
          "hidden_stems_profile_id": {
            "type": "string",
            "title": "Hidden Stems Profile Id"
          },
          "month_context": {
            "additionalProperties": true,
            "type": "object",
            "title": "Month Context"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_four_pillars",
          "source_candidate_id",
          "hidden_stems_profile_id"
        ],
        "title": "BaziStructurePayload"
      },
      "BirthPlace": {
        "properties": {
          "latitude": {
            "type": "string",
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
            "title": "Latitude"
          },
          "longitude": {
            "type": "string",
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
            "title": "Longitude"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "precision": {
            "type": "string",
            "title": "Precision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "latitude",
          "longitude",
          "name",
          "precision"
        ],
        "title": "BirthPlace"
      },
      "BirthRecord": {
        "properties": {
          "local_date": {
            "type": "string",
            "title": "Local Date"
          },
          "local_time": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Local Time"
          },
          "calendar_type": {
            "type": "string",
            "title": "Calendar Type"
          },
          "time_precision": {
            "type": "string",
            "title": "Time Precision"
          },
          "timezone_id": {
            "type": "string",
            "title": "Timezone Id"
          },
          "place": {
            "$ref": "#/components/schemas/BirthPlace"
          },
          "user_confirmed": {
            "type": "boolean",
            "title": "User Confirmed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "local_date",
          "local_time",
          "calendar_type",
          "time_precision",
          "timezone_id",
          "place",
          "user_confirmed"
        ],
        "title": "BirthRecord"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ProfileRef": {
        "properties": {
          "profile_id": {
            "type": "string",
            "title": "Profile Id"
          },
          "profile_version": {
            "type": "string",
            "title": "Profile Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "profile_id",
          "profile_version"
        ],
        "title": "ProfileRef"
      },
      "StructurePillar": {
        "properties": {
          "stem": {
            "type": "string",
            "title": "Stem"
          },
          "branch": {
            "type": "string",
            "title": "Branch"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "stem",
          "branch"
        ],
        "title": "StructurePillar"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
